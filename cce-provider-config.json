{
  "app": "NeuraOS",
  "standalone": true,
  "engine_source": "standalone",
  "provider_manager": {
    "catalog_url": "https://models.dev/api/providers",
    "models_catalog": "https://models.dev/api/models",
    "auth_method": "os_keyring",
    "auth_service": "Secret Service over D-Bus",
    "secrets_file": "~/.config/neuraos/auth.json"
  },
  "models": {
    "default_provider": "cce",
    "default_model": "claude-sonnet-4",
    "context_floor_tokens": 70000
  },
  "providers": {
    "cce": {
      "id": "cce",
      "label": "Claude Code Enhanced",
      "protocol": "Anthropic",
      "base_url": "https://api.anthropic.com/v1",
      "auth_header": "x-api-key",
      "default_model": "claude-sonnet-4",
      "small_model": "claude-haiku",
      "starred": true,
      "configured": true
    }
  }
}
